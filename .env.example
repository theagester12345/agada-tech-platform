# Copy to `.env` (gitignored) and fill in the values.
#
# NEVER commit `.env` — see WORKFLOW.md → Secrets & environment. This file is the
# CONTRACT: it carries variable NAMES only, never values. Agents read this file;
# agents never read the real `.env`. Real process env always wins over `.env`.

# --- Tracker sync (Plane adapter — see adapters/plane/README.md) ---
PLANE_URL=                 # e.g. https://plane.example.com
PLANE_WORKSPACE=           # workspace slug
PLANE_PROJECT_ID=          # project uuid
PLANE_API_TOKEN=           # workspace API token (Workspace settings → API tokens)
PLANE_KEY_PREFIX=          # BE- / FE- / WF- — namespaces external_id per consumer

# Optional overrides:
# PLANE_EXTERNAL_SOURCE=tasks-md
# PLANE_LABEL_MAP={"Frontend":"Frontend","Backend":"Backend","Infrastructure":"Infrastructure"}
# TASKS_FILE=TASK.md
